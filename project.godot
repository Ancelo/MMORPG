; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but may be edited directly in certain situations.

[application]

config/name="Roma Aeterna"
config/description="Synchronous third-person MMORPG set in Ancient Rome"
config/version="0.1.0"
run/main_scene="res://scenes/menus/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/ui/icon.png"

[autoload]

GameManager="*res://scripts/autoloads/GameManager.gd"
NetworkManager="*res://scripts/autoloads/NetworkManager.gd"
DataManager="*res://scripts/autoloads/DataManager.gd"
EventBus="*res://scripts/autoloads/EventBus.gd"
DatabaseManager="*res://scripts/database/DatabaseManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

3d/run_on_separate_thread=true

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.03, 1)

